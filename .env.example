# Database Configuration
DATABASE_URL=postgresql://metro_user:metro_password@localhost:5432/metro_security
REDIS_URL=redis://localhost:6379

# Security Keys (Generate new ones for production)
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production

# AI Model Configuration
MODEL_PATH=models/mistral/mistral-7b-instruct-v0.1.Q4_K_M.gguf

# Application Configuration
FLASK_ENV=development
FLASK_DEBUG=True
ENVIRONMENT=development

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:5000

# Monitoring Configuration
SENTRY_DSN=your-sentry-dsn-here
PROMETHEUS_PORT=9090

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/metro_security.log

# Rate Limiting
RATE_LIMIT_STORAGE_URL=redis://localhost:6379
RATE_LIMIT_DEFAULT=1000 per hour

# Session Configuration
SESSION_TYPE=redis
SESSION_REDIS=redis://localhost:6379
SESSION_PERMANENT=False
PERMANENT_SESSION_LIFETIME=3600

# WebSocket Configuration
SOCKET_IO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000